# ─── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ─── PyInstaller ───────────────────────────────────────────
# 打包中间产物，可重新生成
/build/
*.manifest
warn-*.txt
xref-*.html

# ─── 构建产物 ───────────────────────────────────────────────
# dist/ 里的文件夹版和 zip 是纯二进制，每次打包整个变一遍，
# git 存二进制是整份存的，几十个版本就是几百 MB。
# 需要留档就用 GitHub Releases 挂附件，源码版本用 git tag 记。
/dist/

# ─── 系统垃圾 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── 编辑器 ─────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*~

# ─── 运行时生成的配置 ───────────────────────────────────────
# 真实配置在 %APPDATA%\BinFloater\，项目目录里不该有
config.json
